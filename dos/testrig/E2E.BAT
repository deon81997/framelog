@ECHO OFF
REM E2E.BAT plain|sbemu [FPS] - FRAMELOG end to end: (SC55 first if sbemu), FRAMELOG on COM1, FLIP 12 s, /STATUS
C:
CD \NUKEDSB
CALL SETUP C > NUL
ECHO == e2e %1 %2 > C:\RESULT.LOG
IF "%1"=="sbemu" CALL C:\SC55\SC55.BAT > C:\SBOUT.TXT
IF NOT "%1"=="sbemu" C:\HDPMI\HDPMI32I.EXE -r -x > NUL
C:\FRAMELOG.EXE >> C:\RESULT.LOG
C:\FRAMELOG.EXE >> C:\RESULT.LOG
C:\DOS\CHOICE /T:Y,3 /C:YN wait > NUL
C:\FLIP.EXE 12 %2 10 >> C:\RESULT.LOG
C:\FRAMELOG.EXE /STATUS >> C:\RESULT.LOG
C:\DOS\CHOICE /T:Y,2 /C:YN wait > NUL
C:\FLIP.EXE 1 %2 0 >> C:\RESULT.LOG
C:\FRAMELOG.EXE /STATUS >> C:\RESULT.LOG
ECHO DONE PASS >> C:\RESULT.LOG
