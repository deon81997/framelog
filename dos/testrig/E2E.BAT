@ECHO OFF
REM E2E.BAT plain|sbemu|rm|rmsbemu [FPS] [FLIP flags, B = VESA 4F07h flips] - FRAMELOG end to end: (SC55 first if sbemu,
REM SC55JEM if rmsbemu), FRAMELOG on COM1, FLIP 12 s (rm*: FRAMELOG /RM + RMFLIP.COM, real mode under JEMM), /STATUS
C:
CD \NUKEDSB
CALL SETUP C > NUL
ECHO == e2e %1 %2 %3 > C:\RESULT.LOG
SET FO=
IF "%1"=="rm" SET FO=/RM
IF "%1"=="rmsbemu" SET FO=/RM
IF "%1"=="sbemu" CALL C:\SC55\SC55.BAT > C:\SBOUT.TXT
IF "%1"=="rmsbemu" CALL C:\SC55\SC55JEM.BAT > C:\SBOUT.TXT
IF "%1"=="rm" C:\SC55\RM\JEMM\JLOAD.EXE C:\SC55\RM\JEMM\QPIEMU.DLL >> C:\RESULT.LOG
IF "%1"=="rm" C:\HDPMI\HDPMI32I.EXE -r -x > NUL
IF "%1"=="plain" C:\HDPMI\HDPMI32I.EXE -r -x > NUL
C:
C:\FRAMELOG.EXE %FO% >> C:\RESULT.LOG
C:\FRAMELOG.EXE %FO% >> C:\RESULT.LOG
C:\DOS\CHOICE /T:Y,3 /C:YN wait > NUL
IF "%FO%"=="/RM" C:\RMFLIP.COM >> C:\RESULT.LOG
IF NOT "%FO%"=="/RM" C:\FLIP.EXE 12 %2 10 %3 >> C:\RESULT.LOG
C:\FRAMELOG.EXE /STATUS >> C:\RESULT.LOG
C:\DOS\CHOICE /T:Y,2 /C:YN wait > NUL
IF NOT "%FO%"=="/RM" C:\FLIP.EXE 1 %2 0 %3 >> C:\RESULT.LOG
IF "%FO%"=="/RM" C:\FLIP.EXE 1 %2 0 %3 >> C:\RESULT.LOG
C:\FRAMELOG.EXE /STATUS >> C:\RESULT.LOG
ECHO DONE PASS >> C:\RESULT.LOG
