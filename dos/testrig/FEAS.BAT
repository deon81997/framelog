@ECHO OFF
REM FEAS.BAT A|B|C - milestone 1a: A = FLTSR alone, B = SC55 (SBEMU) then FLTSR, C = FLTSR then SC55
C:
CD \NUKEDSB
CALL SETUP C > NUL
ECHO == feas %1 > C:\RESULT.LOG
IF "%1"=="A" GOTO ALONE
IF "%1"=="C" GOTO TSRFIRST
CALL C:\SC55\SC55.BAT > C:\SBOUT.TXT
C:\FLTSR.EXE > C:\FT0.TXT
GOTO TEST
:TSRFIRST
C:\HDPMI\HDPMI32I.EXE -r -x > NUL
C:\FLTSR.EXE > C:\FT0.TXT
CALL C:\SC55\SC55.BAT > C:\SBOUT.TXT
GOTO TEST
:ALONE
C:\HDPMI\HDPMI32I.EXE -r -x > NUL
C:\FLTSR.EXE > C:\FT0.TXT
C:\FLTEST.EXE 1000 > C:\FT1.TXT
GOTO END
:TEST
C:
CD \SC55
SBDIAG START > NUL
C:\FLTEST.EXE 1000 SB > C:\FT1.TXT
MPUTEST > C:\MPU.TXT
IF ERRORLEVEL 1 ECHO MPUTEST errorlevel set > C:\MPUERR.TXT
C:\FLTEST.EXE 200 SB > C:\FT2.TXT
SBDIAG > C:\SBD.TXT
:END
ECHO == end >> C:\RESULT.LOG
ECHO DONE PASS >> C:\RESULT.LOG
