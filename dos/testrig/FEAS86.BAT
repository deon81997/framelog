@ECHO OFF
REM FEAS86.BAT N|B|C - 1a on 86Box PII-450 + ES1371: N = SC55 only, B = SC55 then FLTSR, C = FLTSR then SC55.
REM SBDIAG over FLTEST + 30 s of MIDPLAY (SC-55) -> C:\SBD.TXT
C:
CD \NUKEDSB
CALL SETUP C > NUL
ECHO == feas86 %1 > C:\RESULT.LOG
IF "%1"=="C" GOTO TSRFIRST
CALL C:\SC55\SC55.BAT > C:\SBOUT.TXT
IF "%1"=="B" C:\FLTSR.EXE > C:\FT0.TXT
GOTO TEST
:TSRFIRST
C:\HDPMI\HDPMI32I.EXE -r -x > NUL
C:\FLTSR.EXE > C:\FT0.TXT
CALL C:\SC55\SC55.BAT > C:\SBOUT.TXT
:TEST
C:
CD \SC55
SBDIAG START > NUL
C:\FLTEST.EXE 1000 SB > C:\FT1.TXT
MIDPLAY.EXE /S /Q:30 C:\T.MID > NUL
C:\FLTEST.EXE 200 SB > C:\FT2.TXT
SBDIAG > C:\SBD.TXT
ECHO DONE PASS >> C:\RESULT.LOG
